+/** Return a short Chinese explanation while leaving the original error intact. */
+export function summarizeServerError(error?: string | null): string {
+  if (!error?.trim()) return '等待首次设备采样';
+  if (/remote host identification has changed|host key.*has changed/i.test(error)) {
+    return 'SSH 主机密钥已变化，请核对指纹';
+  }
+  if (/host key verification failed/i.test(error)) return 'SSH 主机身份校验失败';
+  if (/permission denied|authentication failed|认证失败|认证被拒绝/i.test(error)) {
+    return 'SSH 认证失败，请检查登录凭据';
+  }
+  if (/timed? out|timeout|连接超时/i.test(error)) return 'SSH 连接超时，请检查网络';
+  if (/connection refused/i.test(error)) return 'SSH 连接被拒绝，请检查端口';
+  if (/no route to host|network is unreachable/i.test(error)) return '服务器网络不可达';
+  if (/could not resolve hostname|name or service not known|temporary failure in name resolution/i.test(error)) {
+    return '服务器地址解析失败';
+  }
+  if (/connection (?:reset|closed)|broken pipe/i.test(error)) return 'SSH 连接中断';
+  return '采集失败，请查看错误详情';
+}
