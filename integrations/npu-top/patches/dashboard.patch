+export type BulkTagMode = 'add' | 'remove';
+
+const key = (tag: string) => tag.toLowerCase();
+const SYSTEM_TAG = '低优先级';
+
+export function bulkTagChoices(servers: readonly { tags: readonly string[] }[], pending: readonly string[] = []): { tag: string; count: number; protected: boolean }[] {
+  const choices = new Map<string, { tag: string; count: number; protected: boolean }>();
+  for (const server of servers) {
+    const seen = new Set<string>();
+    for (const tag of server.tags) {
+      const tagKey = key(tag);
+      if (seen.has(tagKey)) continue;
+      seen.add(tagKey);
+      const choice = choices.get(tagKey) || { tag, count: 0, protected: tag === SYSTEM_TAG };
+      choice.count += 1;
+      choices.set(tagKey, choice);
+    }
+  }
+  for (const tag of pending) {
+    if (!choices.has(key(tag))) choices.set(key(tag), { tag, count: 0, protected: tag === SYSTEM_TAG });
+  }
+  return [...choices.values()].sort((left, right) => left.tag.localeCompare(right.tag, 'zh-CN'));
+}
+
+export function parseBulkTags(value: string, mode: BulkTagMode): string[] {
+  const tags: string[] = [];
+  const seen = new Set<string>();
+  for (const item of value.split(/[|,，\n]/)) {
+    const tag = item.trim();
+    if (!tag || seen.has(key(tag))) continue;
+    if (Array.from(tag).length > 60) throw new Error('每个标签最多 60 个字符，请缩短后再试');
+    seen.add(key(tag));
+    tags.push(tag);
+  }
+  if (!tags.length) throw new Error('请输入至少一个标签');
+  if (tags.length > 20) throw new Error('一次最多操作 20 个标签');
+  if (mode === 'remove' && tags.includes(SYSTEM_TAG)) throw new Error('“低优先级”是系统标签，请从移除列表中去掉');
+  return tags;
+}
+
+export function mergeBulkTags(current: readonly string[], tags: readonly string[], mode: BulkTagMode): string[] {
+  if (mode === 'remove' && tags.includes(SYSTEM_TAG)) throw new Error('不能批量移除系统“低优先级”标签');
+  const changes = new Set(tags.map(key));
+  const result = mode === 'remove' ? current.filter((tag) => !changes.has(key(tag))) : [...current];
+  if (mode === 'add') {
+    const existing = new Set(current.map(key));
+    for (const tag of tags) {
+      if (!existing.has(key(tag))) { result.push(tag); existing.add(key(tag)); }
+    }
+  }
+  const changed = JSON.stringify(result) !== JSON.stringify(current);
+  if (changed && result.length > 20) throw new Error('更新后标签总数超过 20 个，请先移除部分标签');
+  if (changed && result.some((tag) => Array.from(tag).length > 60)) throw new Error('剩余标签中有超过 60 字符的既有标签，本次不覆盖，请先单独核对');
+  return result;
+}
