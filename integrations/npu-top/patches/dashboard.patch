+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { URL } from 'node:url';
+import test from 'node:test';
+import ts from 'typescript';
+
+const { outputText: source } = ts.transpileModule(readFileSync(new URL('../app/bulk-tags.ts', import.meta.url), 'utf8'), {
+  compilerOptions: { module: ts.ModuleKind.ES2022, target: ts.ScriptTarget.ES2022 },
+});
+const { parseBulkTags, mergeBulkTags, bulkTagChoices } = await import('data:text/javascript,' + encodeURIComponent(source));
+
+test('adding preserves distinct existing tags, casing, order and input arrays; retry is idempotent', () => {
+  const original = Object.freeze(['训练', 'Prod', '低优先级']);
+  const changes = parseBulkTags(' 新组 | prod， 新组\n共享', 'add');
+  const added = mergeBulkTags(original, changes, 'add');
+  assert.deepEqual(added, ['训练', 'Prod', '低优先级', '新组', '共享']);
+  assert.deepEqual(mergeBulkTags(added, changes, 'add'), added);
+  assert.deepEqual(original, ['训练', 'Prod', '低优先级']);
+});
+
+test('removing affects only requested labels and retains system/other labels; retry is idempotent', () => {
+  const original = Object.freeze(['训练', 'Prod', '低优先级', '共享']);
+  const changes = parseBulkTags('PROD, 不存在', 'remove');
+  const removed = mergeBulkTags(original, changes, 'remove');
+  assert.deepEqual(removed, ['训练', '低优先级', '共享']);
+  assert.deepEqual(mergeBulkTags(removed, changes, 'remove'), removed);
+  assert.throws(() => parseBulkTags('训练 | 低优先级', 'remove'), /系统标签/);
+  assert.throws(() => mergeBulkTags(original, ['低优先级'], 'remove'), /系统/);
+});
+
+test('empty, oversized and overflow inputs fail without truncating or dropping current tags', () => {
+  assert.throws(() => parseBulkTags(' | ，\n ', 'add'), /至少一个/);
+  assert.throws(() => parseBulkTags('标'.repeat(61), 'add'), /60/);
+  assert.equal(parseBulkTags('😀'.repeat(60), 'add')[0].length, 120);
+  const full = Object.freeze(Array.from({ length: 20 }, (_, index) => '组' + index));
+  assert.throws(() => parseBulkTags(full.concat('额外').join('|'), 'add'), /20/);
+  assert.throws(() => mergeBulkTags(full, ['额外'], 'add'), /20/);
+  assert.deepEqual(mergeBulkTags(full, ['组0'], 'add'), full);
+  assert.equal(full.length, 20);
+  const longTag = '原'.repeat(61);
+  assert.throws(() => mergeBulkTags([longTag], ['新组'], 'add'), /60/);
+  assert.deepEqual(mergeBulkTags([longTag], [], 'remove'), [longTag]);
+  assert.deepEqual(mergeBulkTags([longTag, '保留'], [longTag], 'remove'), ['保留']);
+});
+
+test('existing removal candidates count distinct machines and preserve exact labels and uncertain retry choices', () => {
+  const literal = '研发,阶段|甲';
+  const choices = bulkTagChoices([{ tags: ['训练', 'Prod', 'Prod', '低优先级', literal] }, { tags: ['训练', 'prod'] }], ['待核对']);
+  assert.deepEqual(choices.find(item => item.tag === '训练'), { tag: '训练', count: 2, protected: false });
+  assert.deepEqual(choices.find(item => item.tag === 'Prod'), { tag: 'Prod', count: 2, protected: false });
+  assert.deepEqual(choices.find(item => item.tag === '低优先级'), { tag: '低优先级', count: 1, protected: true });
+  assert.deepEqual(choices.find(item => item.tag === literal), { tag: literal, count: 1, protected: false });
+  assert.deepEqual(choices.find(item => item.tag === '待核对'), { tag: '待核对', count: 0, protected: false });
+  assert.deepEqual(mergeBulkTags([literal, '训练'], [literal], 'remove'), ['训练']);
+});
