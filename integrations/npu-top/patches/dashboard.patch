+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { URL } from 'node:url';
+import test from 'node:test';
+import ts from 'typescript';
+
+const { outputText } = ts.transpileModule(readFileSync(new URL('../app/group-preferences.ts', import.meta.url), 'utf8'), {
+  compilerOptions: { module: ts.ModuleKind.ES2022, target: ts.ScriptTarget.ES2022 },
+});
+const { decodeGroupPreferences, reconcileGroupPreferences } = await import('data:text/javascript,' + encodeURIComponent(outputText));
+
+test('stored selection and explicit collapsed states survive decoding without restoring other UI state', () => {
+  const decoded = decodeGroupPreferences(JSON.stringify({ version: 1, selectedGroupKey: 'tag:训练',
+    expandedGroups: { all: false, 'tag:训练': false, 'tag:推理': true, untagged: true, bad: true, 'tag:bad': 'false' },
+    showDisabledServers: true, bulkServerIds: ['example'] }));
+  assert.deepEqual(decoded, { version: 1, selectedGroupKey: 'tag:训练',
+    expandedGroups: { all: false, 'tag:训练': false, 'tag:推理': true, untagged: true } });
+  const longTag = '已有清单标签'.repeat(20);
+  const longSaved = decodeGroupPreferences(JSON.stringify({ version: 1, selectedGroupKey: 'tag:' + longTag, expandedGroups: { all: true } }));
+  assert.equal(reconcileGroupPreferences(longSaved, [{ tags: [longTag] }]).selectedGroupKey, 'tag:' + longTag);
+});
+
+test('missing, corrupt, unknown-schema and unsafe preference data recover safe defaults', () => {
+  const expected = { version: 1, selectedGroupKey: 'all', expandedGroups: { all: true } };
+  for (const raw of [null, '{', 'null', '[]', 'true', '{"version":99}', '{"version":1,"selectedGroupKey":17,"expandedGroups":[]}']) {
+    assert.deepEqual(decodeGroupPreferences(raw), expected);
+  }
+  assert.deepEqual(decodeGroupPreferences('{"version":1,"selectedGroupKey":"__proto__","expandedGroups":{"__proto__":true,"constructor":true}}'), expected);
+  assert.equal(Object.prototype.polluted, undefined);
+});
+
+test('authoritative inventory prunes vanished groups and keeps the fallback stable when a tag later reappears', () => {
+  const saved = decodeGroupPreferences('{"version":1,"selectedGroupKey":"tag:旧组","expandedGroups":{"all":false,"tag:旧组":true,"tag:训练":false}}');
+  const reconciled = reconcileGroupPreferences(saved, [{ tags: ['训练'] }]);
+  assert.deepEqual(reconciled, { version: 1, selectedGroupKey: 'all', expandedGroups: { all: false, 'tag:训练': false } });
+  assert.equal(reconcileGroupPreferences(reconciled, [{ tags: ['训练', '旧组'] }]), reconciled);
+  const active = decodeGroupPreferences('{"version":1,"selectedGroupKey":"untagged","expandedGroups":{"all":false,"untagged":true}}');
+  assert.equal(reconcileGroupPreferences(active, [{ tags: [] }]), active);
+});
