+export const GROUP_PREFERENCES_KEY = 'ascend-workbench:npu-top:server-groups:v1';
+export type GroupPreferences = { version: 1; selectedGroupKey: string; expandedGroups: Record<string, boolean> };
+
+function defaults(): GroupPreferences { return { version: 1, selectedGroupKey: 'all', expandedGroups: { all: true } }; }
+function validKey(value: unknown): value is string {
+  return typeof value === 'string' && (value === 'all' || value === 'untagged' ||
+    (value.startsWith('tag:') && value.length > 4));
+}
+
+export function decodeGroupPreferences(raw: string | null): GroupPreferences {
+  try {
+    const data = JSON.parse(raw || 'null');
+    if (!data || typeof data !== 'object' || Array.isArray(data) || data.version !== 1) return defaults();
+    const entries = data.expandedGroups && typeof data.expandedGroups === 'object' && !Array.isArray(data.expandedGroups)
+      ? Object.entries(data.expandedGroups).filter(([key, value]) => validKey(key) && typeof value === 'boolean') : [];
+    return { version: 1, selectedGroupKey: validKey(data.selectedGroupKey) ? data.selectedGroupKey : 'all',
+      expandedGroups: { all: true, ...Object.fromEntries(entries) } };
+  } catch { return defaults(); }
+}
+
+export function readGroupPreferences(): GroupPreferences {
+  try { return decodeGroupPreferences(window.localStorage.getItem(GROUP_PREFERENCES_KEY)); }
+  catch { return defaults(); }
+}
+
+export function saveGroupPreferences(value: GroupPreferences): void {
+  try {
+    window.localStorage.setItem(GROUP_PREFERENCES_KEY, JSON.stringify({ version: 1,
+      selectedGroupKey: value.selectedGroupKey, expandedGroups: value.expandedGroups }));
+  } catch { /* Storage may be disabled or full; in-page controls still work. */ }
+}
+
+export function reconcileGroupPreferences(value: GroupPreferences, servers: readonly { tags: readonly string[] }[]): GroupPreferences {
+  const available = new Set(['all']);
+  for (const server of servers) {
+    if (!server.tags.length) available.add('untagged');
+    for (const tag of server.tags) available.add(`tag:${tag}`);
+  }
+  const selectedGroupKey = available.has(value.selectedGroupKey) ? value.selectedGroupKey : 'all';
+  const expandedGroups = Object.fromEntries(Object.entries(value.expandedGroups).filter(([key]) => available.has(key)));
+  if (selectedGroupKey === value.selectedGroupKey && Object.keys(expandedGroups).length === Object.keys(value.expandedGroups).length) return value;
+  return { version: 1, selectedGroupKey, expandedGroups };
+}
