+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { readFileSync } from 'node:fs';
+import { URL } from 'node:url';
+import ts from 'typescript';
+
+const { outputText } = ts.transpileModule(
+  readFileSync(new URL('../app/server-errors.ts', import.meta.url), 'utf8'),
+  { compilerOptions: { module: ts.ModuleKind.ES2022, target: ts.ScriptTarget.ES2022 } },
+);
+const { summarizeServerError } = await import(`data:text/javascript,${encodeURIComponent(outputText)}`);
+
+test('extracts a host identity warning from the complete multiline SSH banner', () => {
+  const error = '@@@@@@@@@@@@@@@\r\n@ WARNING: REMOTE HOST IDENTIFICATION HAS CHANGED! @\r\nHost key verification failed.\r\n';
+  assert.equal(summarizeServerError(error), 'SSH 主机密钥已变化，请核对指纹');
+  assert.ok(error.startsWith('@@@@@@@@@@@@@@@\r\n'));
+});
+
+test('distinguishes authentication, timeout and connection failures', () => {
+  const cases = [
